# Copy to .env and fill in. Never commit .env.

# Token Chord sends as "Authorization: Bearer ..." — register the MCP server
# with auth_type "bearer" and paste the same value there.
# Generate one: openssl rand -hex 32
MCP_BEARER_TOKEN=

# --- Ledger ------------------------------------------------------------------
# "sheets" for the real Google Sheet, "csv" to read data/*.csv locally.
# Defaults to sheets when GOOGLE_SHEET_ID is set, csv otherwise.
LEDGER_BACKEND=csv

# The long id in the sheet URL, between /d/ and /edit
GOOGLE_SHEET_ID=
# Share the sheet with this address as an Editor or nothing will work
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Where the local CSV ledger lives (LEDGER_BACKEND=csv only)
LEDGER_CSV_DIR=data

# --- Paystack ----------------------------------------------------------------
# TEST key only. The server refuses to report healthy on an sk_live key.
PAYSTACK_SECRET_KEY=sk_test_xxx
# "live" calls Paystack, "mock" serves a local two-button checkout page.
# Defaults to live when a sk_ key is present, mock otherwise.
PAYSTACK_MODE=mock

# --- Hosting -----------------------------------------------------------------
PORT=3000
# The server's own public HTTPS URL, used for mock checkout links.
# Render sets RENDER_EXTERNAL_URL and Railway sets RAILWAY_PUBLIC_DOMAIN, so
# this is only needed elsewhere.
PUBLIC_BASE_URL=
